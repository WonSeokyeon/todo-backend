# 이 파일은 실제 값을 채운 뒤 "todolist.env"로 저장해 WinSCP로 EC2의 /etc/todolist/ 에 업로드한다.
# 이 example 파일만 커밋 대상이고, 실제 값이 채워진 todolist.env는 절대 커밋하지 않는다
# (저장소 바깥, EC2 안에만 존재해야 한다).

SPRING_PROFILES_ACTIVE=prod

# --- Database (RDS) ---
# currentSchema 쿼리 파라미터를 붙이지 않는다 — 스키마가 아니라 독립 데이터베이스 방식이다 (CLAUDE.md 4장).
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/todolist_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=

# --- CORS / Frontend ---
# CORS_ALLOWED_ORIGINS는 쉼표 구분 목록, FRONTEND_URL은 단일 URL이다 — 겸용 금지 (CLAUDE.md 6장).
CORS_ALLOWED_ORIGINS=https://main.d2y8rsr3tqdjn.amplifyapp.com
FRONTEND_URL=https://main.d2y8rsr3tqdjn.amplifyapp.com

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- S3 ---
# 자격증명은 EC2에 부여한 IAM Role이 제공한다. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY는 여기에 넣지 않는다.
S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2

# --- 임시: nginx+HTTPS 붙이기 전까지만 ---
# 지금은 백엔드가 평문 HTTP(:8080)로만 응답해 Secure 쿠키가 브라우저에 저장되지 않는다.
# nginx 도입 후에는 이 두 줄을 삭제한다 — application-prod.properties의 기본값(true/None)으로 복귀한다.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
