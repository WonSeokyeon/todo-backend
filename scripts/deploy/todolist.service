[Unit]
Description=Todo List Backend (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=todolist
Group=todolist
WorkingDirectory=/etc/todolist
EnvironmentFile=/etc/todolist/todolist.env
EnvironmentFile=/etc/todolist/todolist.conf
ExecStart=/usr/bin/java $JAVA_OPTS -jar /etc/todolist/app.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
