#!/bin/sh
#
# commit-msg — Conventional Commits 형식 검사
# 프론트엔드의 commitlint 와 동일한 규칙을 셸로 구현했다. (CLAUDE.md 6장)
#

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

MSG_FILE="$1"
# 주석(#)과 빈 줄을 제외한 첫 줄이 제목이다.
SUBJECT=$(grep -v '^#' "$MSG_FILE" | grep -v '^[[:space:]]*$' | head -1)

if [ -z "$SUBJECT" ]; then
  printf "${RED}✖ 커밋 메시지가 비어 있습니다.${NC}\n"
  exit 1
fi

# merge / revert 자동 생성 커밋은 검사하지 않는다.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*)
    exit 0
    ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_./-]+\))?!?: .+'

if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
  printf "${RED}✖ 커밋 메시지 형식이 올바르지 않습니다.${NC}\n\n"
  printf "  입력한 메시지: ${YELLOW}%s${NC}\n\n" "$SUBJECT"
  printf "  형식: ${GREEN}<타입>(<범위>): <제목>${NC}\n"
  printf "  타입: feat fix docs style refactor perf test build ci chore revert\n\n"
  printf "  예시:\n"
  printf "    ${GREEN}feat: 할 일 생성 API 추가${NC}\n"
  printf "    ${GREEN}fix(auth): 리프레시 토큰 회전 시 이전 토큰이 폐기되지 않던 문제 수정${NC}\n"
  printf "    ${GREEN}test(todo): 소유권 검증 테스트 추가${NC}\n\n"
  exit 1
fi

# 제목 길이 제한 (한글 기준 72자)
LENGTH=$(printf '%s' "$SUBJECT" | wc -m | tr -d ' ')
if [ "$LENGTH" -gt 72 ]; then
  printf "${RED}✖ 제목이 너무 깁니다. (%s자 / 최대 72자)${NC}\n" "$LENGTH"
  printf "  → 자세한 설명은 빈 줄을 하나 두고 본문에 작성하세요.\n"
  exit 1
fi

# 제목 끝 마침표 금지
case "$SUBJECT" in
  *.)
    printf "${RED}✖ 제목 끝에 마침표(.)를 쓰지 않습니다.${NC}\n"
    exit 1
    ;;
esac

printf "${GREEN}✔ 커밋 메시지 형식 확인${NC}\n"
exit 0
