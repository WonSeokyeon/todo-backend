# 로컬 개발 설정 템플릿
#
# 사용법:
#   cp application-local.properties.example application-local.properties
# 후 실제 값을 채운다. (application-local.properties 는 커밋되지 않는다)

# 로컬 PostgreSQL 비밀번호
spring.datasource.password=여기에_로컬_DB_비밀번호

# JWT 서명키 (예: openssl rand -base64 48)
jwt.secret=여기에_로컬_JWT_시크릿

# Google OAuth2를 실제로 테스트하려면 Google Cloud Console에서 발급받아 채운다.
# (비워두면 기동은 되지만 /oauth2/authorization/google 호출 시 구글이 거부한다)
# spring.security.oauth2.client.registration.google.client-id=여기에_구글_클라이언트_ID
# spring.security.oauth2.client.registration.google.client-secret=여기에_구글_클라이언트_시크릿

# 필요 시 아래 항목도 덮어쓸 수 있다.
# spring.datasource.url=jdbc:postgresql://localhost:5432/todolist_db
# spring.datasource.username=postgres

# Phase 13 — S3 전환을 로컬 기본값으로 쓰려면 type을 s3로, 버킷명을 채운다.
# 로컬 디스크를 쓰려면 이 두 줄을 지우거나 주석 처리한다(기본값은 local).
# 자격증명은 여기 두지 않는다 — aws configure로 만든 ~/.aws/credentials를 기본 체인이 찾는다.
# app.storage.type=s3
# app.storage.s3.bucket=여기에_S3_버킷명
