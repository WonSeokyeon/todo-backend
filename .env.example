# 실제 값은 이 파일을 복사해 .env 또는 프로파일별 *.properties(예: application-local.properties)에 둔다.
# .env 자체는 Spring Boot가 자동으로 읽지 않으므로, 실행 전 환경변수로 export 하거나
# application-local.properties에 값을 채워 넣는 방식으로 주입한다.

# --- 실행 프로파일 ---
SPRING_PROFILES_ACTIVE=local

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/todolist_db
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
# 예: openssl rand -base64 48
JWT_SECRET=

# --- CORS ---
# 쉼표 구분 목록. FRONTEND_URL(단일 URL, OAuth2 전용)과 헷갈리지 말 것.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Refresh Token 쿠키 (로컬 기본값. 운영은 application-prod.properties에서 고정값 사용) ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- OAuth2 리다이렉트 기준 URL (단일 URL. CORS_ALLOWED_ORIGINS와 겸용 금지) ---
FRONTEND_URL=http://localhost:3000

# --- Google OAuth2 (Google Cloud Console에서 발급) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
